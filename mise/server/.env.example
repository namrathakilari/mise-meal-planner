# Copy to .env (or export these in your shell / hosting dashboard).
# Without GROQ_API_KEY the AI endpoints still work using a built-in
# offline recipe engine, so the app never breaks
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
PORT=8787
# Where household data is stored (JSON files)
DATA_DIR=./data
